{
  "name": "arqevon-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test tests/sync.test.mjs tests/vercel.test.mjs tests/custodia.test.mjs",
    "test:e2e": "ARQEVON_BILLING=1 node scripts/build.mjs && node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:regressao": "ARQEVON_BILLING=1 node scripts/build.mjs && node tests/e2e/regressao.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer-core": "24.43.1"
  }
}
