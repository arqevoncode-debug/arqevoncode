# Sistema operacional e editores
.DS_Store
.idea/
.vscode/
*.swp

# Dependências e caches
**/node_modules/
**/.next/
**/.turbo/
**/dist/
**/target/
**/coverage/
**/.wrangler/
**/.vinext/
**/.vercel/
**/supabase/.temp/

# Ambientes e credenciais
**/.env
**/.env.*
!**/.env.example
**/.admin-password
**/.admin-session-secret
**/.supabase-db-password
**/.license-private.pem
**/.license-public.pem
**/*.p12
**/*.key

# Esta chave é pública e necessária para builds reproduzíveis do desktop.
!apps/finance-desktop/config/license-public.pem

# Logs e temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
tmp/

# Artefatos locais de build. Os dois instaladores publicados na landing page
# são intencionalmente versionados como baseline da versão 1.0.5.
*.exe
*.dmg
!apps/site/public/downloads/Arqevon-Finance-1.0.5-Windows-x64-Setup-v3.exe
!apps/site/public/downloads/Arqevon-Finance-1.0.5-macOS-Apple-Silicon.dmg
