# Sistema operacional e editores
.DS_Store
.idea/
.vscode/
*.swp

# Dependências e caches
**/node_modules/
**/.next/
**/.turbo/
**/dist/
**/target/
**/coverage/
**/.wrangler/
**/.vinext/
**/.vercel/
**/supabase/.temp/

# Ambientes e credenciais
**/.env
**/.env.*
!**/.env.example
**/.admin-password
**/.admin-session-secret
**/.supabase-db-password
**/.license-private.pem
**/.license-public.pem
**/*.p12
**/*.key

# Esta chave é pública e necessária para builds reproduzíveis do desktop.
!apps/finance-desktop/config/license-public.pem

# Logs e temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
tmp/

# Artefatos locais de build. Somente os instaladores efetivamente publicados na
# landing page são versionados, um por linha, para que nenhum binário entre no
# repositório por acidente.
*.exe
*.dmg
!apps/site/public/downloads/Arqevon-Finance-1.0.5-Windows-x64-Setup-v3.exe
!apps/site/public/downloads/Arqevon-Finance-1.0.5-macOS-Apple-Silicon.dmg
!apps/site/public/downloads/Arqevon-Finance-1.0.6-Windows-x64-Setup.exe
!apps/site/public/downloads/Arqevon-Finance-1.0.6-macOS-Apple-Silicon.dmg
